# Copy to secrets.env (same folder), chmod 600. Never commit the real file.
# JSON files refer to these as "${NAME}", for example  "api_key": "${SONARR_API_KEY}".

# Needed for speaker diarization (accept the terms of pyannote/speaker-diarization-community-1 first)
HF_TOKEN=

# Optional API token for scripts that call the bridge's web UI API (header X-Token). The web UI itself uses a user name
# and password that you choose the first time you open it. Create one with:  python subcfg/subcfg.py init-token
WEBUI_TOKEN=

# Optional: show context from Sonarr / Radarr in translation prompts
SONARR_API_KEY=
RADARR_API_KEY=
